# --- oczyszczalnia-aio (Uptime Kuma) ---
KUMA_PORT=3001

# --- każdy host (Netdata) — ustaw unikalną nazwę ---
MONITORING_HOSTNAME=oczyszczalnia-aio

# Uwaga: URL-e Push (UPTIME_KUMA_*_PUSH_URL) wpisuj w GŁÓWNYM pliku
# ~/mes-parafina-app/.env — NIE tutaj. backup-mes.sh i healthcheck czytają tylko .env.

# Opcjonalnie: Netdata Cloud (puste = tylko lokalny panel :19999)
# NETDATA_CLAIM_TOKEN=
# NETDATA_CLAIM_URL=https://app.netdata.cloud
# NETDATA_CLAIM_ROOMS=

# --- oczyszczalnia-aio (panel metryk — agreguje Netdata z hostów) ---
METRICS_DASHBOARD_PORT=3080
NETDATA_HOSTS=terminal3,terminal1,oczyszczalnia-aio
NETDATA_PORT=19999
NETDATA_DISK_CHART=disk_space./
DASHBOARD_REFRESH_SECONDS=30
# Opcjonalnie: własne opisy ról hostów (host:opis, oddzielone przecinkami)
# NETDATA_HOST_ROLES=terminal3:Produkcja,terminal1:Standby,oczyszczalnia-aio:Monitoring

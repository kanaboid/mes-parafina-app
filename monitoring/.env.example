# --- oczyszczalnia-aio (Uptime Kuma) ---
KUMA_PORT=3001

# --- każdy host (Netdata) — ustaw unikalną nazwę ---
MONITORING_HOSTNAME=oczyszczalnia-aio

# Uwaga: URL-e Push (UPTIME_KUMA_*_PUSH_URL) wpisuj w GŁÓWNYM pliku
# ~/mes-parafina-app/.env — NIE tutaj. backup-mes.sh i healthcheck czytają tylko .env.

# Opcjonalnie: Netdata Cloud (puste = tylko lokalny panel :19999)
# NETDATA_CLAIM_TOKEN=
# NETDATA_CLAIM_URL=https://app.netdata.cloud
# NETDATA_CLAIM_ROOMS=
